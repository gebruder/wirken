#!/usr/bin/env bash
# Reject commit messages that leak local paths or attribute the work
# to a tool. The rules are the ones scripts/check-names.sh applies in
# CI: a co-author trailer naming the tool or its vendor is refused, a
# co-author trailer naming a person is allowed.
#
# Install: scripts/git-hooks/install.sh
# Test:    scripts/git-hooks/test-commit-msg.sh
set -euo pipefail

msg_file="${1:?usage: commit-msg <path>}"
msg=$(cat "$msg_file")
payload=$(printf '%s\n' "$msg" | grep -v '^#' || true)
subject=$(printf '%s\n' "$payload" | head -n 1)

fail=0
report() {
	printf 'commit-msg: %s\n' "$1" >&2
	fail=1
}

if printf '%s' "$payload" | grep -qE '(/home/|/Users/)[a-z]'; then
	report 'absolute home path in message; use $REPO or a relative path'
fi

# The name is written as a character class so this file passes
# check-names itself.
if printf '%s' "$payload" | grep -qiE '^[[:space:]]*co-authored-by:.*(c[l]aude|anthropic)'; then
	report 'co-author trailer naming the tool or its vendor'
fi

if printf '%s' "$payload" | grep -qiE '^Generated with '; then
	report 'attribution trailer (Generated with)'
fi

if printf '%s' "$subject" | grep -qiE '^(generated|written|created|authored).{0,20}(with|by).{0,20}(c[l]aude|anthropic|cursor|copilot|gemini)'; then
	report 'subject suggests AI authorship attribution'
fi

if printf '%s' "$subject" | grep -q '^🤖'; then
	report 'subject starts with 🤖'
fi

if [ $fail -ne 0 ]; then
	printf '\n-- rejected message --\n%s\n--\n' "$msg" >&2
	exit 1
fi

exit 0
