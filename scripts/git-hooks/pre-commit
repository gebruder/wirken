#!/usr/bin/env bash
# Reject staging product-named filenames and AI-tool dotfile paths,
# and reject .gitignore additions that reference AI-tool tokens.
#
# Install: scripts/git-hooks/install.sh
set -euo pipefail

fail=0
report() {
	printf 'pre-commit: %s\n' "$1" >&2
	fail=1
}

# Names are written as character classes (C[L]AUDE) so this file does
# not itself contain the names it rejects; the patterns match the same
# strings.

# Caps tokens anchored at start of a path component, separator-bounded.
# Matches AGENTS.md, GEMINI.json, CURSOR-rules, ANTHROPIC_NOTES,
# but not crates/cli/src/commands/agents.rs (lowercase).
banned_caps='^(C[L]AUDE|ANTHROPIC|AGENTS|CURSOR|COPILOT|GEMINI)([._\-]|$)'

# Dotfile path components for AI tools (any case).
# Matches .cursor/anything, .cursorrules, .aider.conf.yml.
banned_dot='^\.(c[l]aude|cursor|copilot|aider)'

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)

for f in "${staged[@]}"; do
	[ -z "$f" ] && continue
	IFS='/' read -ra parts <<<"$f"
	for p in "${parts[@]}"; do
		if printf '%s' "$p" | grep -qE "$banned_caps"; then
			report "AI-tool config filename in path: $f (component: $p)"
		fi
		if printf '%s' "$p" | grep -qiE "$banned_dot"; then
			report "AI-tool dotfile path: $f (component: $p)"
		fi
	done
done

# .gitignore added-line scan (only ADDED lines, grandfathers existing entries).
if printf '%s\n' "${staged[@]}" | grep -qE '(^|/)\.gitignore$'; then
	added=$(git diff --cached -U0 -- '*.gitignore' '.gitignore' | grep -E '^\+[^+]' || true)
	if printf '%s\n' "$added" | grep -qiE '\b(c[l]aude|anthropic|cursor|copilot|gemini|aider)\b'; then
		printf 'pre-commit: .gitignore added line references AI-tool token:\n' >&2
		printf '%s\n' "$added" | grep -iE '\b(c[l]aude|anthropic|cursor|copilot|gemini|aider)\b' >&2
		fail=1
	fi
fi

exit $fail
